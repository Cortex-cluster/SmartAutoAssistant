<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_card"
    android:padding="20dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/bg_card_stroke"
        android:layout_marginBottom="16dp" />

    <!-- Header Section -->
    <TextView
        android:id="@+id/tvDetailCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CATEGORY"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/accent_cyan"
        android:letterSpacing="0.08"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Feature Title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bg_card_stroke"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp" />

    <!-- Description -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How It Works"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/accent_green" />

    <TextView
        android:id="@+id/tvDetailDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Detailed explanation of what the feature does."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="3dp"
        android:layout_marginTop="6dp" />

    <!-- Trigger Info & Permissions -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trigger &amp; Required System Access"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/accent_orange"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvDetailTrigger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trigger requirements info"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="2dp"
        android:layout_marginTop="6dp" />

    <!-- Voice Commands Section (Visible when feature has commands) -->
    <LinearLayout
        android:id="@+id/layoutVoiceCommands"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Supported Voice Commands (Bilingual)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accent_cyan" />

        <TextView
            android:id="@+id/tvDetailVoiceCommands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• 'pick up', 'answer'\n• 'uthao', 'काटो'"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDetailClose"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Got it"
        android:textColor="@color/bg_primary"
        android:textStyle="bold"
        app:backgroundTint="@color/accent_cyan"
        app:cornerRadius="10dp"
        android:layout_marginTop="20dp" />

</LinearLayout>
